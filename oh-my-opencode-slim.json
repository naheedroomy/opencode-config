{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "nuz-optimized",
  "disabled_agents": [],

  "presets": {
    "nuz-optimized": {
      "orchestrator": {
        "model": "openai/gpt-5.5",
        "variant": "medium",
        "skills": ["*"],
        "mcps": ["*", "!context7"]
      },

      "oracle": {
        "model": "openai/gpt-5.5",
        "variant": "high",
        "skills": [],
        "mcps": []
      },

      "council": {
        "model": "openai/gpt-5.5",
        "variant": "high"
      },

      "librarian": {
        "model": "openai/gpt-5.4-mini",
        "variant": "low",
        "skills": [],
        "mcps": ["websearch", "context7", "grep_app"]
      },

      "explorer": {
        "model": "opencode-go/qwen3.6-plus",
        "skills": [],
        "mcps": []
      },

      "designer": {
        "model": "opencode-go/qwen3.6-plus",
        "skills": [],
        "mcps": []
      },

      "fixer": {
        "model": "opencode-go/deepseek-v4-pro",
        "skills": [],
        "mcps": []
      },

      "observer": {
        "model": "opencode-go/kimi-k2.6"
      }
    }
  },

  "multiplexer": {
    "type": "auto",
    "layout": "main-vertical",
    "main_pane_size": 62
  },

  "council": {
    "timeout": 300000,
    "default_preset": "nuz-optimized",

    "presets": {
      "nuz-optimized": {
        "alpha": {
          "model": "openai/gpt-5.5",
          "variant": "high"
        },

        "beta": {
          "model": "opencode-go/glm-5.1"
        },

        "gamma": {
          "model": "opencode-go/qwen3.7-max"
        }
      }
    }
  },

  "todoContinuation": {
    "maxContinuations": 50,
    "cooldownMs": 2500,
    "autoEnable": true,
    "autoEnableThreshold": 4
  }
}
