{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "opencode-with-claude"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "tools": {
    "websearch": true,
    "codesearch": true
  },
  "permission": {
    "websearch": "allow",
    "codesearch": "allow"
  },
  "share": "disabled",
  "experimental": {
    "openTelemetry": false
  },
  "lsp": true
}
